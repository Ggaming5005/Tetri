{
  "AllowedHosts": "*",
  "Database": {
    "ApplyMigrations": false,
    "MaxPoolSize": 64
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
