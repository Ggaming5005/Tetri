{
  "AllowedHosts": "*",
  "Database": {
    "ApplyMigrations": false,
    "MaxPoolSize": 64
  },
  "Jwt": {
    "Issuer": "Tetri",
    "Audience": "Tetri.Mobile"
  },
  "RateLimits": {
    "AuthPermitLimit": 5,
    "HandlePermitLimit": 20,
    "MoneyPermitLimit": 30,
    "WindowSeconds": 60
  },
  "Fx": {
    "Spread": 0.005,
    "FetchEnabled": true,
    "RefreshHours": 6
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
